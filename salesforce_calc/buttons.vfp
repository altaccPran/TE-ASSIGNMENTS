<apex:page controller="ScientificCalculatorController" lightningStylesheets="true">
    <apex:form>
        <apex:pageMessages />

        <apex:pageBlock title="Scientific Calculator">
            
            <apex:pageBlockSection columns="1">
                <apex:inputText value="{!a}" label="Value 1"/>
                <apex:inputText value="{!b}" label="Value 2"/>
            </apex:pageBlockSection>

            <apex:pageBlockSection columns="1">
                <apex:outputText value="Result: {!result}" style="font-size:18px; font-weight:bold;" />
            </apex:pageBlockSection>

            <apex:pageBlockButtons>
                <apex:commandButton value="+" action="{!add}" />
                <apex:commandButton value="-" action="{!subtract}" />
                <apex:commandButton value="*" action="{!multiply}" />
                <apex:commandButton value="/" action="{!divide}" />
                <apex:commandButton value="x^y" action="{!power}" />
                <apex:commandButton value="√" action="{!sqrt}" />
                <apex:commandButton value="log" action="{!log}" />
                <apex:commandButton value="Clear" action="{!clear}" />
                <apex:commandButton value="sin" action="{!sin}" />
				<apex:commandButton value="cos" action="{!cos}" />
				<apex:commandButton value="tan" action="{!tan}" />
            </apex:pageBlockButtons>

        </apex:pageBlock>
    </apex:form>
</apex:page>
