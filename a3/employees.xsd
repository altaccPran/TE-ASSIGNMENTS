<?xml version="1.0" encoding="UTF-8"?>

<!--
  XML Schema for employees.xml
  Extends the DTD with datatype constraints (decimal salary, ID attribute, email pattern).
  Validate with xmllint using the schema and instance file in this folder.
-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="employees">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="employee" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="firstName" type="xs:string"/>
                            <xs:element name="lastName" type="xs:string"/>
                            <xs:element name="department" type="xs:string"/>
                            <xs:element name="designation" type="xs:string"/>
                            <xs:element name="salary" type="xs:decimal"/>
                            <xs:element name="email" type="emailString"/>
                        </xs:sequence>
                        <xs:attribute name="employeeId" type="xs:ID" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="emailString">
        <xs:restriction base="xs:string">
            <xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
